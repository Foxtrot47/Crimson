<ContentDialog
    x:Class="Crimson.Controls.GameImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:strings="using:Crimson.Resources"
    xmlns:models="using:Crimson.ViewModels"
    xmlns:utils="using:Crimson.Utils"
    CloseButtonText="{x:Bind strings:UiStrings.Cancel}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanImport, Mode=OneWay}"
    Opened="DialogOpened"
    Closing="DialogClosing"
    PrimaryButtonClick="ImportSelected"
    PrimaryButtonText="{x:Bind strings:UiStrings.Import}">
    <ContentDialog.Resources>
        <utils:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <utils:ImageUrlConverter x:Key="ImageUrlConverter" />
        <x:Double x:Key="ContentDialogMaxWidth">688</x:Double>
    </ContentDialog.Resources>
    <StackPanel x:Name="DialogContent" Spacing="12">
        <ProgressBar
            IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        <TextBlock
            TextWrapping="Wrap"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        <ListView
            x:Name="GameList"
            MaxHeight="320"
            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
            SelectionChanged="GameSelectionChanged"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:GameImportChoice">
                    <Grid Padding="0,6" ColumnSpacing="14" AutomationProperties.Name="{x:Bind Title}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Height="64"
                            VerticalAlignment="Center"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="4">
                            <Grid>
                                <FontIcon FontSize="20" Glyph="&#xE7FC;" Opacity="0.5" />
                                <Image
                                    Source="{x:Bind ImageUrl, Converter={StaticResource ImageUrlConverter}}"
                                    Stretch="UniformToFill"
                                    AutomationProperties.Name="{x:Bind strings:UiStrings.GameArtwork}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="Wrap" />
                            <TextBlock FontSize="12" Opacity="0.8" Text="{x:Bind LocationHint}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                AutomationProperties.Name="{x:Bind strings:UiStrings.InstallLocation}"
                IsReadOnly="True"
                PlaceholderText="{x:Bind strings:UiStrings.ChooseTheGameFolderToImport}"
                Text="{x:Bind ViewModel.Location, Mode=OneWay}" />
            <Button
                Grid.Column="1"
                Click="ChooseFolderClicked"
                Content="{x:Bind strings:UiStrings.ChooseFolder}"
                IsEnabled="{x:Bind ViewModel.CanChooseLocation, Mode=OneWay}" />
        </Grid>
    </StackPanel>
</ContentDialog>
