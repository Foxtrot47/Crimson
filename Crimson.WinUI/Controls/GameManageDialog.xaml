<UserControl
    x:Class="Crimson.Controls.GameManageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:strings="using:Crimson.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:utils="using:Crimson.Utils"
    xmlns:viewModels="using:Crimson.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <utils:ImageUrlConverter x:Key="ImageUrlConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <AcrylicBrush
            x:Key="ManageDialogAcrylicBrush"
            FallbackColor="#F21C1C1C"
            TintColor="#1C1C1C"
            TintLuminosityOpacity="0.72"
            TintOpacity="0.68" />
    </UserControl.Resources>

    <ContentDialog
        x:Name="ManageContentDialog"
        Padding="0"
        Background="Transparent"
        Opened="ManageContentDialogOpened">
        <ContentDialog.Resources>
            <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
            <x:Double x:Key="ContentDialogMaxHeight">800</x:Double>
            <Thickness x:Key="ContentDialogPadding">0</Thickness>
        </ContentDialog.Resources>

        <Grid
            x:Name="DialogContent"
            Background="{StaticResource ManageDialogAcrylicBrush}"
            KeyDown="DialogContentKeyDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="24,28,20,24"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Text="{x:Bind GameTitle, Mode=OneTime}"
                    TextWrapping="Wrap" />

                <ListView
                    x:Name="SectionList"
                    Grid.Row="1"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionChanged="SectionSelectionChanged"
                    SelectionMode="Single">
                    <ListView.Resources>
                        <CornerRadius x:Key="ListViewItemCornerRadius">0</CornerRadius>
                        <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="24,10,16,10" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="UseSystemFocusVisuals" Value="True" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListViewItem Content="{x:Bind strings:UiStrings.General}" Tag="General" />
                    <ListViewItem Content="{x:Bind strings:UiStrings.InstalledFiles}" Tag="InstalledFiles" />
                    <ListViewItem Content="{x:Bind strings:UiStrings.DLC}" Tag="Dlc" />
                </ListView>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="ActionErrorText"
                    Margin="28,24,60,0"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto">
                    <Grid Padding="28,28,28,28">
                        <StackPanel x:Name="GeneralPanel" Spacing="20">
                            <TextBlock Margin="0,0,44,0" Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind strings:UiStrings.General}" TextWrapping="Wrap" />

                            <Border
                                Padding="18"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind strings:UiStrings.GameStatus}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind GameStatus, Mode=OneTime}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="4">
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind strings:UiStrings.InstalledBuild}" />
                                        <TextBlock
                                            MaxWidth="260"
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind InstalledBuild, Mode=OneTime}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border
                                Padding="18"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind strings:UiStrings.DesktopShortcut}" />
                                    <Button
                                        x:Name="CreateShortcutButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind strings:UiStrings.CreateDesktopShortcut}"
                                        Click="CreateShortcutClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ProgressRing
                                                x:Name="ShortcutProgressRing"
                                                Width="16"
                                                Height="16"
                                                IsActive="False"
                                                Visibility="Collapsed" />
                                            <FontIcon x:Name="ShortcutIcon" Glyph="&#xE8A7;" />
                                            <TextBlock Text="{x:Bind strings:UiStrings.CreateShortcut}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="InstalledFilesPanel" Spacing="20" Visibility="Collapsed">
                            <TextBlock Margin="0,0,44,0" Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind strings:UiStrings.InstalledFiles}" TextWrapping="Wrap" />

                            <Border
                                Padding="18"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind strings:UiStrings.SizeOfInstallation}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="InstalledSizeText" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind InstallLocation, Mode=OneTime}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind strings:UiStrings.BrowseInstallationFiles}"
                                        Click="BrowseFilesClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE838;" />
                                            <TextBlock Text="{x:Bind strings:UiStrings.BrowseFiles}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <StackPanel Spacing="10">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="{x:Bind strings:UiStrings.VerifyAndRepairGameFiles}"
                                    Click="VerifyRepairClicked">
                                    <Grid Padding="6" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE90F;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind strings:UiStrings.VerifyAndRepairFiles}" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" />
                                    </Grid>
                                </Button>

                                <Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="{x:Bind strings:UiStrings.MoveGameInstallation}"
                                    Click="MoveGameClicked">
                                    <Grid Padding="6" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8DE;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind strings:UiStrings.MoveInstallation}" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" />
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <Border
                                Padding="18"
                                BorderBrush="#66C42B1C"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="12">
                                    <Grid x:Name="UninstallAction" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind strings:UiStrings.Uninstall}" />
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind strings:UiStrings.UninstallGame}"
                                            Background="#C42B1C"
                                            Click="RequestUninstallClicked"
                                            Foreground="White">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE74D;" />
                                                <TextBlock Text="{x:Bind strings:UiStrings.Uninstall}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <StackPanel x:Name="UninstallConfirmation" Spacing="12" Visibility="Collapsed">
                                        <TextBlock
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind strings:UiStrings.UninstallThisGame}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind strings:UiStrings.ThisRemovesTheManagedInstallationBackUpLocalFilesYouWantToKeep}"
                                            TextWrapping="Wrap" />
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Name="CancelUninstallButton"
                                                Click="CancelUninstallClicked"
                                                Content="{x:Bind strings:UiStrings.Cancel}" />
                                            <Button
                                                AutomationProperties.Name="{x:Bind strings:UiStrings.ConfirmUninstallGame}"
                                                Background="#C42B1C"
                                                Click="ConfirmUninstallClicked"
                                                Content="{x:Bind strings:UiStrings.UninstallGame}"
                                                Foreground="White" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="DlcPanel" Spacing="20" Visibility="Collapsed">
                            <TextBlock Margin="0,0,44,0" Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind strings:UiStrings.DLC}" />
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Content="{x:Bind strings:UiStrings.ViewInStore}"
                                        IsEnabled="{x:Bind CanViewStore, Mode=OneTime}"
                                        Click="ViewInStoreClicked" />
                                    <TextBox
                                        x:Name="DlcSearch"
                                        Grid.Column="1"
                                        PlaceholderText="{x:Bind strings:UiStrings.SearchDLC}"
                                        AutomationProperties.Name="{x:Bind strings:UiStrings.SearchDLC}"
                                        Text="{x:Bind Dlcs.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Padding="12,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind strings:UiStrings.Install}" />
                                    <TextBlock Grid.Column="1" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind strings:UiStrings.Name}" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind strings:UiStrings.Size}" />
                                </Grid>
                                <ListView
                                    x:Name="DlcList"
                                    MaxHeight="340"
                                    Padding="0"
                                    ItemsSource="{x:Bind Dlcs.Items, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                            <Setter Property="Padding" Value="12,8" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:GameDlcItem">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    VerticalAlignment="Center"
                                                    MinWidth="0"
                                                    AutomationProperties.Name="{x:Bind InstallLabel}"
                                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                    IsEnabled="{x:Bind CanEdit, Mode=OneWay}" />
                                                <Grid Grid.Column="1" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Height="36" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="3">
                                                        <Grid>
                                                            <FontIcon FontSize="18" Glyph="&#xE7FC;" Opacity="0.5" />
                                                            <Image Source="{x:Bind ImageUrl, Converter={StaticResource ImageUrlConverter}}" Stretch="UniformToFill" AutomationProperties.Name="{x:Bind strings:UiStrings.DLCArtwork}" />
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind SizeText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock
                                    Text="{x:Bind Dlcs.EmptyMessage, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="{x:Bind Dlcs.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind Dlcs.BlockedMessage, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind Dlcs.IsBlocked, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Button
                                x:Name="DlcApplyButton"
                                HorizontalAlignment="Right"
                                Content="{x:Bind strings:UiStrings.Apply}"
                                IsEnabled="{x:Bind Dlcs.CanApply, Mode=OneWay}"
                                Visibility="{x:Bind Dlcs.ShowApply, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Click="ApplyDlcClicked" />
                            <StackPanel x:Name="DlcConfirmation" Spacing="12" Visibility="Collapsed">
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind strings:UiStrings.ApplyDLCRemovals}" />
                                <TextBlock Text="{x:Bind strings:UiStrings.FilesSharedWithTheGameOrOtherInstalledContentWillBeKept}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="CancelDlcButton" Content="{x:Bind strings:UiStrings.Cancel}" Click="CancelDlcClicked" />
                                    <Button Content="{x:Bind strings:UiStrings.ApplyChanges}" Click="ConfirmDlcClicked" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

            </Grid>

            <Button
                x:Name="CloseButton"
                Grid.Column="1"
                Width="36"
                Height="36"
                Margin="0,16,16,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                AutomationProperties.Name="{x:Bind strings:UiStrings.CloseGameProperties}"
                Click="CloseButtonClicked"
                ToolTipService.ToolTip="{x:Bind strings:UiStrings.Close}">
                <FontIcon FontSize="16" Glyph="&#xE711;" />
            </Button>
        </Grid>
    </ContentDialog>
</UserControl>
