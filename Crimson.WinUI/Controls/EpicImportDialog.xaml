<ContentDialog
    x:Class="Crimson.Controls.EpicImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:strings="using:Crimson.Resources"
    xmlns:models="using:Crimson.ViewModels"
    xmlns:utils="using:Crimson.Utils"
    Title="{x:Bind strings:UiStrings.ImportFromEpic}"
    CloseButtonText="{x:Bind strings:UiStrings.Cancel}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanImport, Mode=OneWay}"
    Opened="DialogOpened"
    Closing="DialogClosing"
    PrimaryButtonClick="ImportSelected"
    PrimaryButtonText="{x:Bind strings:UiStrings.ImportSelected}">
    <ContentDialog.Resources>
        <utils:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <utils:ImageUrlConverter x:Key="ImageUrlConverter" />
        <x:Double x:Key="ContentDialogMaxWidth">688</x:Double>
    </ContentDialog.Resources>
    <StackPanel x:Name="DialogContent" Spacing="12">
        <ProgressBar
            IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        <TextBlock
            TextWrapping="Wrap"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:EpicImportChoice">
                        <ToggleButton
                            Margin="0,4"
                            Padding="14"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="{x:Bind Title}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Height="86"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="4">
                                    <Grid>
                                        <FontIcon FontSize="24" Glyph="&#xE7FC;" Opacity="0.5" />
                                        <Image
                                            Source="{x:Bind ImageUrl, Converter={StaticResource ImageUrlConverter}}"
                                            Stretch="UniformToFill"
                                            AutomationProperties.Name="{x:Bind strings:UiStrings.GameArtwork}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                    <TextBlock FontSize="12" Opacity="0.8" Text="{x:Bind Installation.InstallLocation}" TextWrapping="Wrap" />
                                    <TextBlock FontSize="12" Opacity="0.8" Text="{x:Bind Installation.BuildVersion}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</ContentDialog>
