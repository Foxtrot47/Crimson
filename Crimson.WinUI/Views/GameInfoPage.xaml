<Page
    x:Class="Crimson.Views.GameInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:strings="using:Crimson.Resources"
    xmlns:controls="using:Crimson.Controls"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Crimson.Models"
    xmlns:utils="using:Crimson.Utils"
    SizeChanged="GameInfoPageSizeChanged"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <utils:GamePrimaryActionGlyphConverter x:Key="GamePrimaryActionGlyphConverter" />
        <utils:ImageUrlConverter x:Key="ImageUrlConverter" />
        <AcrylicBrush
            x:Key="GameInfoOverlayBrush"
            FallbackColor="#EA171717"
            TintColor="#171717"
            TintLuminosityOpacity="0.72"
            TintOpacity="0.70" />
    </Page.Resources>

    <Grid x:Name="LayoutRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact" />
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1400" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OverviewGrid.ColumnSpacing" Value="28" />
                        <Setter Target="OverviewGrid.RowSpacing" Value="0" />
                        <Setter Target="CoverColumn.Width" Value="220" />
                        <Setter Target="ContentColumn.Width" Value="*" />
                        <Setter Target="SideColumn.Width" Value="280" />
                        <Setter Target="CoverCard.HorizontalAlignment" Value="Left" />
                        <Setter Target="MainCard.(Grid.Row)" Value="0" />
                        <Setter Target="MainCard.(Grid.Column)" Value="1" />
                        <Setter Target="SidePanel.(Grid.Row)" Value="0" />
                        <Setter Target="SidePanel.(Grid.Column)" Value="2" />
                        <Setter Target="ActionPanel.Orientation" Value="Horizontal" />
                        <Setter Target="GameTitle.FontSize" Value="40" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                MaxWidth="1280"
                Margin="28,24,28,48"
                HorizontalAlignment="Center"
                Spacing="28">

                <Border
                    x:Name="HeroSurface"
                    MinHeight="480"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="14">
                    <Grid>
                        <Image
                            x:Name="HeroImage"
                            AutomationProperties.Name="{x:Bind strings:UiStrings.GameBackgroundArtwork}"
                            ImageFailed="HeroImageFailed"
                            ImageOpened="HeroImageOpened"
                            Opacity="0"
                            Source="{x:Bind ViewModel.HeroImageUrl, Mode=OneWay, Converter={StaticResource ImageUrlConverter}}"
                            Stretch="UniformToFill">
                            <Image.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.35" />
                            </Image.OpacityTransition>
                        </Image>

                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#60101010" />
                                    <GradientStop Offset="0.52" Color="#78101010" />
                                    <GradientStop Offset="1" Color="#E8101010" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <ProgressRing
                            x:Name="HeroImageLoadingRing"
                            Width="34"
                            Height="34"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsActive="True"
                            Visibility="{x:Bind ViewModel.HasHeroImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <Grid
                            x:Name="OverviewGrid"
                            Margin="28"
                            VerticalAlignment="Bottom"
                            ColumnSpacing="0"
                            RowSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="CoverColumn" Width="*" />
                                <ColumnDefinition x:Name="ContentColumn" Width="0" />
                                <ColumnDefinition x:Name="SideColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                x:Name="CoverCard"
                                Grid.Row="0"
                                Width="220"
                                Height="293"
                                HorizontalAlignment="Center"
                                Background="#CC202020"
                                CornerRadius="10">
                                <Grid>
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind strings:UiStrings.CoverArtworkUnavailable}"
                                        FontSize="40"
                                        Glyph="&#xE7FC;"
                                        Opacity="0.65" />
                                    <ProgressRing
                                        x:Name="CoverImageLoadingRing"
                                        Width="28"
                                        Height="28"
                                        IsActive="True"
                                        Visibility="{x:Bind ViewModel.HasCoverImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Image
                                        x:Name="CoverImage"
                                        AutomationProperties.Name="{x:Bind strings:UiStrings.GameCoverArtwork}"
                                        ImageFailed="CoverImageFailed"
                                        ImageOpened="CoverImageOpened"
                                        Opacity="0"
                                        Source="{x:Bind ViewModel.CoverImageUrl, Mode=OneWay, Converter={StaticResource ImageUrlConverter}}"
                                        Stretch="UniformToFill">
                                        <Image.OpacityTransition>
                                            <ScalarTransition Duration="0:0:0.25" />
                                        </Image.OpacityTransition>
                                    </Image>
                                </Grid>
                            </Border>

                            <Border
                                x:Name="MainCard"
                                Grid.Row="1"
                                Padding="22"
                                Background="{StaticResource GameInfoOverlayBrush}"
                                CornerRadius="12">
                                <StackPanel x:Name="MainPanel" Spacing="16">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                x:Name="GameTitle"
                                                Foreground="White"
                                                FontSize="32"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind ViewModel.Game.AppTitle, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                            <Border
                                                Grid.Column="1"
                                                Padding="10,5"
                                                VerticalAlignment="Center"
                                                Background="#A62A2A2A"
                                                CornerRadius="12">
                                                <TextBlock
                                                    Foreground="#E6FFFFFF"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind ViewModel.GameStatusText, Mode=OneWay}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock
                                            Foreground="#D6FFFFFF"
                                            Text="{x:Bind ViewModel.DeveloperName, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        Visibility="{x:Bind ViewModel.IsDetailsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ProgressRing
                                            Width="18"
                                            Height="18"
                                            Foreground="White"
                                            IsActive="{x:Bind ViewModel.IsDetailsLoading, Mode=OneWay}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="#D6FFFFFF"
                                            Text="{x:Bind strings:UiStrings.LoadingStoreDetails}" />
                                    </StackPanel>

                                    <TextBlock
                                        Foreground="#FF8DD8F8"
                                        Text="{x:Bind ViewModel.TagsText, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords"
                                        Visibility="{x:Bind ViewModel.HasTags, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <StackPanel
                                        x:Name="ActionPanel"
                                        Orientation="Vertical"
                                        Spacing="10">
                                        <Button
                                            Padding="20,10"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Command="{x:Bind ViewModel.PrimaryActionCommand}"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            IsEnabled="{x:Bind ViewModel.IsPrimaryActionEnabled, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <ProgressRing
                                                    Width="18"
                                                    Height="18"
                                                    IsActive="True"
                                                    IsIndeterminate="{x:Bind ViewModel.IsProgressRingIndeterminate, Mode=OneWay}"
                                                    Visibility="{x:Bind ViewModel.IsProgressRingVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
                                                <FontIcon Glyph="{x:Bind ViewModel.PrimaryAction, Mode=OneWay, Converter={StaticResource GamePrimaryActionGlyphConverter}}" />
                                                <TextBlock Text="{x:Bind ViewModel.PrimaryActionButtonText, Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Padding="20,10"
                                            Command="{x:Bind ViewModel.ImportGameCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsImportEnabled, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.IsImportVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE8B5;" />
                                                <TextBlock Text="{x:Bind strings:UiStrings.Import}" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Padding="20,10"
                                            AutomationProperties.Name="{x:Bind strings:UiStrings.OpenGameProperties}"
                                            Click="ManageClicked"
                                            IsEnabled="{x:Bind ViewModel.IsManageEnabled, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE713;" />
                                                <TextBlock Text="{x:Bind strings:UiStrings.Manage}" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Width="42"
                                            Height="42"
                                            HorizontalAlignment="Left"
                                            AutomationProperties.Name="{x:Bind strings:UiStrings.ViewInStore}"
                                            ToolTipService.ToolTip="{x:Bind strings:UiStrings.ViewInStore}"
                                            IsEnabled="{x:Bind ViewModel.CanViewStore, Mode=OneWay}"
                                            Click="ViewInStoreClicked">
                                            <FontIcon FontSize="16" Glyph="&#xE8A7;" />
                                        </Button>
                                    </StackPanel>

                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Foreground="#BFFFFFFF" Text="{x:Bind strings:UiStrings.TotalPlayTime}" TextWrapping="Wrap" />
                                            <TextBlock Foreground="White" Text="{x:Bind ViewModel.TotalPlayTimeText, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Foreground="#BFFFFFFF" Text="{x:Bind strings:UiStrings.LastUpdated}" TextWrapping="Wrap" />
                                            <TextBlock Foreground="White" Text="{x:Bind ViewModel.LastUpdatedText, Mode=OneWay}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel
                                x:Name="SidePanel"
                                Grid.Row="2"
                                Spacing="12">
                                <Border
                                    Padding="16"
                                    Background="{StaticResource GameInfoOverlayBrush}"
                                    CornerRadius="10">
                                    <StackPanel Spacing="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Foreground="#BFFFFFFF" Text="{x:Bind strings:UiStrings.Publisher}" />
                                            <TextBlock Foreground="White" Text="{x:Bind ViewModel.PublisherName, Mode=OneWay}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Foreground="#BFFFFFFF" Text="{x:Bind strings:UiStrings.ReleaseDate}" />
                                            <TextBlock Foreground="White" Text="{x:Bind ViewModel.ReleaseDateText, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Foreground="#BFFFFFFF" Text="{x:Bind strings:UiStrings.InstalledBuild}" />
                                            <TextBlock
                                                Foreground="White"
                                                Text="{x:Bind ViewModel.InstalledVersion, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.HasScreenshots, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{x:Bind strings:UiStrings.Screenshots}" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Width="48"
                                Height="48"
                                AutomationProperties.Name="{x:Bind strings:UiStrings.PreviousScreenshots}"
                                Click="PreviousScreenshotsClicked">
                                <FontIcon FontSize="18" Glyph="&#xE76B;" />
                            </Button>
                            <Button
                                Width="48"
                                Height="48"
                                AutomationProperties.Name="{x:Bind strings:UiStrings.NextScreenshots}"
                                Click="NextScreenshotsClicked">
                                <FontIcon FontSize="18" Glyph="&#xE76C;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer
                        x:Name="ScreenshotScroller"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled"
                        ZoomMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Screenshots, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StoreProductImage">
                                    <Button
                                        Width="400"
                                        Height="225"
                                        Margin="0,0,14,0"
                                        Padding="0"
                                        AutomationProperties.HelpText="{x:Bind AltText, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind strings:UiStrings.OpenScreenshot}"
                                        Click="ScreenshotClicked"
                                        Tag="{Binding}">
                                        <Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{x:Bind strings:UiStrings.ScreenshotUnavailable}"
                                                FontSize="32"
                                                Glyph="&#xEB9F;"
                                                Opacity="0.65" />
                                            <ProgressRing
                                                x:Name="ScreenshotLoadingRing"
                                                Width="28"
                                                Height="28"
                                                IsActive="True" />
                                            <Image
                                                ImageFailed="ScreenshotImageFailed"
                                                ImageOpened="ScreenshotImageOpened"
                                                Opacity="0"
                                                Source="{x:Bind Url, Converter={StaticResource ImageUrlConverter}}"
                                                Stretch="UniformToFill">
                                                <Image.OpacityTransition>
                                                    <ScalarTransition Duration="0:0:0.25" />
                                                </Image.OpacityTransition>
                                            </Image>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.HasGameDescription, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{x:Bind strings:UiStrings.About}" />
                    <TextBlock
                        MaxWidth="960"
                        HorizontalAlignment="Left"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        LineHeight="22"
                        Text="{x:Bind ViewModel.GameDescription, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <TextBlock
                    MaxWidth="960"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.ActionErrorMessage, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasActionError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <StackPanel
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.HasWindowsRequirements, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{x:Bind strings:UiStrings.WindowsRequirements}" />
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="10">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <Grid MinWidth="720">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid
                                    Padding="18,14"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind strings:UiStrings.Specification}" />
                                    <TextBlock Grid.Column="1" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind strings:UiStrings.Minimum}" />
                                    <TextBlock Grid.Column="2" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind strings:UiStrings.Recommended}" />
                                </Grid>
                                <ItemsControl
                                    Grid.Row="1"
                                    ItemsSource="{x:Bind ViewModel.WindowsRequirements, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:StoreSystemRequirement">
                                            <Grid Padding="18,14" ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind Title}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Minimum}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Recommended}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ContentDialog
            x:Name="ScreenshotDialog"
            MaxWidth="1200"
            Padding="0"
            Background="Black"
            Opened="ScreenshotDialogOpened">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
                <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
                <Thickness x:Key="ContentDialogPadding">0</Thickness>
            </ContentDialog.Resources>
            <Grid
                x:Name="ScreenshotViewer"
                Background="Black"
                KeyDown="ScreenshotDialogKeyDown">
                <ProgressRing
                    x:Name="ExpandedScreenshotLoadingRing"
                    Width="44"
                    Height="44"
                    IsActive="False" />
                <TextBlock
                    x:Name="ExpandedScreenshotErrorText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind strings:UiStrings.ScreenshotCouldNotBeLoaded}"
                    Visibility="Collapsed" />
                <Image
                    x:Name="ExpandedScreenshotImage"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ImageFailed="ExpandedScreenshotImageFailed"
                    ImageOpened="ExpandedScreenshotImageOpened"
                    Opacity="0"
                    Stretch="Uniform">
                    <Image.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.25" />
                    </Image.OpacityTransition>
                </Image>
                <Button
                    x:Name="ScreenshotCloseButton"
                    Width="52"
                    Height="52"
                    Margin="12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Canvas.ZIndex="10"
                    AutomationProperties.Name="{x:Bind strings:UiStrings.CloseScreenshot}"
                    Background="#F2FFFFFF"
                    BorderBrush="#33000000"
                    BorderThickness="1"
                    Click="CloseScreenshotClicked"
                    Foreground="Black">
                    <FontIcon FontSize="20" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </ContentDialog>

        <controls:AppInstallDialog x:Name="InstallDialog" />
        <controls:GameManageDialog x:Name="ManageDialog" />
    </Grid>
</Page>
