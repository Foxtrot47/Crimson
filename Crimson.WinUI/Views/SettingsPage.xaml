<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Crimson.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:strings="using:Crimson.Resources"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Crimson.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <x:Double x:Key="SettingsCardSpacing">3</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,29,0,5" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <TextBlock
            x:Name="PageHeader"
            Margin="36,24,36,0"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="{x:Bind strings:UiStrings.Settings}" />

        <ScrollViewer
            x:Name="contentSV"
            Grid.Row="1"
            Padding="36,0,36,0"
            IsTabStop="False"
            UseSystemFocusVisuals="False"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>


                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Bind strings:UiStrings.Appearance}" />

                <toolkit:SettingsCard Description="{x:Bind strings:UiStrings.EnableTheAcrylicEffectsAvailableOnWindows11}" Header="{x:Bind strings:UiStrings.EnableAcrylic}">
                    <ToggleSwitch
                        IsEnabled="{x:Bind ViewModel.CanChangeAcrylic, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.AcrylicEnabled, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="{x:Bind strings:UiStrings.AcrylicOpacityDescription}" Header="{x:Bind strings:UiStrings.AcrylicOpacity}">
                    <Slider
                        x:Name="AcrylicOpacitySlider"
                        Width="240"
                        AutomationProperties.Name="{x:Bind strings:UiStrings.AcrylicOpacity}"
                        IsEnabled="{x:Bind ViewModel.CanAdjustAcrylicOpacity, Mode=OneWay}"
                        Maximum="100"
                        Minimum="0"
                        StepFrequency="5"
                        Value="{x:Bind ViewModel.AcrylicOpacity, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <TextBlock
                    Margin="12,6,12,6"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.AcrylicErrorMessage, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasAcrylicError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <toolkit:SettingsCard Header="{x:Bind strings:UiStrings.Language}">
                    <ComboBox
                        x:Name="LanguagePicker"
                        MinWidth="200"
                        ItemsSource="{x:Bind ViewModel.Languages}"
                        DisplayMemberPath="DisplayName"
                        SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=OneWay}"
                        SelectionChanged="LanguageSelectionChanged"
                        AutomationProperties.Name="{x:Bind strings:UiStrings.Language}" />
                </toolkit:SettingsCard>
                <StackPanel
                    Margin="12,6,12,6"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsLanguageRestartRequired, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{x:Bind strings:UiStrings.LanguageRestartRequired}" TextWrapping="Wrap" />
                    <Button Content="{x:Bind strings:UiStrings.RestartCrimson}" Click="RestartClicked" />
                </StackPanel>
                <TextBlock
                    Margin="12,6,12,6"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.LanguageErrorMessage, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasLanguageError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Bind strings:UiStrings.Accounts}" />

                <toolkit:SettingsCard
                    Command="{x:Bind ViewModel.LogoutCommand}"
                    Description="{x:Bind strings:UiStrings.ThisWillLogYouOutFromTheCurrentAccountAndReturnToTheSignInScreen}"
                    Header="{x:Bind strings:UiStrings.Logout}"
                    IsClickEnabled="True" />

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Bind strings:UiStrings.AdvancedSettings}" />

                <toolkit:SettingsCard
                    x:Name="StorageSettingsCard"
                    ActionIcon="{ui:FontIcon Glyph=&#xE76C;}"
                    Click="StorageSettingsClicked"
                    Header="{x:Bind strings:UiStrings.StorageSection}"
                    HeaderIcon="{ui:FontIcon Glyph=&#xEDA2;}"
                    IsClickEnabled="True" />

                <toolkit:SettingsExpander
                    x:Name="AdvancedSettingsCard"
                    Header="{x:Bind strings:UiStrings.ShowAdavancedSettings}"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE713;}"
                    IsExpanded="{x:Bind ViewModel.AdvancedSettingsExpanded, Mode=TwoWay}">

                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                            Command="{x:Bind ViewModel.OpenLogsDirectoryCommand}"
                            Header="{x:Bind strings:UiStrings.OpenLogsDirectory}"
                            IsClickEnabled="True" />
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

            </StackPanel>

        </ScrollViewer>
    </Grid>
</Page>
