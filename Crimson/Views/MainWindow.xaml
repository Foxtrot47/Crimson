<Window
    x:Class="Crimson.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:crimson="using:Crimson.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Crimson.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <Image
                Width="16"
                Height="16"
                Margin="8,0"
                HorizontalAlignment="Left"
                Source="Images/WindowIcon.png" />
            <TextBlock
                x:Name="AppTitleTextBlock"
                Margin="28,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Crimson"
                TextWrapping="NoWrap" />
        </Grid>

        <Grid Grid.Row="1">
            <NavigationView
                x:Name="NavControl"
                BackRequested="NavControl_BackRequested"
                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                IsBackEnabled="True"
                ItemInvoked="NavControl_ItemInvoked"
                CompactPaneLength="56"
                OpenPaneLength="340">
                <NavigationView.Resources>
                    <!--  Taller pane items than the stock default, to fit game box art.  -->
                    <x:Double x:Key="NavigationViewItemOnLeftMinHeight">56</x:Double>
                    <!--
                        Shared by every row, so it stays near the 16px stock value to keep the
                        Library, Downloads and Settings glyphs proportioned. Game rows raise it
                        on themselves in MainWindow.CreateInstalledGameItem.
                    -->
                    <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">18</x:Double>
                </NavigationView.Resources>
                <NavigationView.MenuItems>
                    <NavigationViewItem
                        Content="Library"
                        Icon="Library"
                        Tag="Crimson.Views.LibraryPage" />
                    <!--  Installed games are appended here by MainWindow.RebuildInstalledMenu.  -->
                </NavigationView.MenuItems>

                <ScrollViewer>
                    <Frame x:Name="ContentFrame" IsTabStop="True" />
                </ScrollViewer>

                <NavigationView.FooterMenuItems>
                    <!--
                        NavigationViewItem hides its Content in the ClosedCompact state, so without
                        an Icon this item rendered blank once the pane collapsed.
                    -->
                    <NavigationViewItem
                        x:Name="DownloadsNavItem"
                        Tag="Crimson.Views.DownloadsPage"
                        ToolTipService.ToolTip="No downloads in queue">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE896;" />
                        </NavigationViewItem.Icon>
                        <NavigationViewItem.InfoBadge>
                            <InfoBadge x:Name="DownloadInfoBadge" Visibility="Collapsed" />
                        </NavigationViewItem.InfoBadge>
                        <crimson:CurrentDownloadControl x:Name="CurrentDownload" />
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>
            </NavigationView>

            <Grid
                x:Name="LoginModal"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <Border
                    Padding="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <StackPanel Orientation="Vertical" Spacing="20">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="20">
                            <ProgressRing IsActive="True" />
                            <TextBlock
                                x:Name="LoginModalTitle"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Style="{ThemeResource TitleTextBlockStyle}"
                                Text="Loading...." />
                        </StackPanel>
                        <TextBlock
                            x:Name="LoginModalDescription"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="Please wait" />
                    </StackPanel>
                </Border>
            </Grid>
            <local:LoginPage x:Name="LoginPage" Visibility="Collapsed" />
        </Grid>
        <crimson:TrayIconView x:Name="TrayIconView" />
    </Grid>
</Window>