<Page
    x:Class="Crimson.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Crimson.Views"
    xmlns:presentation="using:Crimson.Presentation"
    xmlns:utils="using:Crimson.Utils"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="GamesGrid" HorizontalAlignment="Center">
        <Grid.Resources>
            <UniformGridLayout x:Name="UniformGridLayout" />
            <DataTemplate x:Key="GameCardTemplate" x:DataType="presentation:LibraryItemViewModel">
                <Button
                    Padding="16,16,16,16"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="GameButton_Click"
                    DataContext="{x:Bind}">
                    <StackPanel Spacing="20">
                        <Image
                            Width="226"
                            Height="300"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{x:Bind ImageUri, Converter={StaticResource UriToBitmapImageConverter}}"
                            Stretch="UniformToFill" />
                        <TextBlock
                            MaxWidth="200"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            FontSize="18"
                            Foreground="White"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </DataTemplate>
        </Grid.Resources>

        <StackPanel
            x:Name="LoadingSection"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <ProgressRing
                Width="50"
                Height="50"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="White"
                IsActive="True" />
            <TextBlock>Loading...</TextBlock>
        </StackPanel>

        <ItemsRepeater
            x:Name="ItemsRepeater"
            Margin="0,20,0,20"
            ItemTemplate="{StaticResource GameCardTemplate}"
            ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
            Layout="{StaticResource UniformGridLayout}" />
    </Grid>

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <utils:UriToBitmapImageConverter x:Key="UriToBitmapImageConverter" />
    </Page.Resources>
</Page>